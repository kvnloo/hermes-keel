[Unit]
Description=Hermes Keel narrow LF-006 external supervisor
After=default.target

[Service]
Type=simple
ExecStart=@PYTHON@ @SOURCE@ --socket=%t/hermes-keel/lf006.sock --db=@DB@ --board=@BOARD@ --receipts=%h/.local/state/hermes-keel/lf006-receipts.jsonl
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Socket + receipts are owned state. The board directory must be writable only
# because SQLite WAL mode needs -shm/-wal coordination even for SELECT.
ReadWritePaths=%t/hermes-keel %h/.local/state/hermes-keel @BOARD_DIR@
# systemctl talks to the user manager over the private D-Bus socket.
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
TimeoutStopSec=5

[Install]
WantedBy=default.target
