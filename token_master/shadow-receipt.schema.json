{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-keel.invalid/token-master/shadow-v0.1.json",
  "title": "Token Master shadow receipt",
  "type": "object",
  "required": ["schemaVersion", "taskId", "runId", "mode", "attribution", "anomalies"],
  "properties": {
    "schemaVersion": {"const": "token-master-shadow.v0.1"},
    "taskId": {"type": "string", "pattern": "^t_[A-Za-z0-9]+$"},
    "runId": {"type": "string", "minLength": 1},
    "mode": {"const": "shadow"},
    "attribution": {"enum": ["task-run", "unknown", "shared-subscription"]},
    "provider": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "observedTokens": {"type": ["integer", "null"], "minimum": 0},
    "estimate": {"type": ["object", "null"]},
    "anomalies": {"type": "array", "items": {"type": "object", "required": ["rule", "severity", "dedupeKey"]}},
    "authority": {"const": "advisory-only"}
  },
  "additionalProperties": false
}
